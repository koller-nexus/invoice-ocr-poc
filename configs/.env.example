# ============================================================
# Invoice OCR PoC - Environment Configuration
# ============================================================

# --- Server ---
LOG_FORMAT=text
PORT=8080
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=8388608

# --- Workers ---
WORKER_COUNT=2
JOB_QUEUE_SIZE=32
PREP_WORKERS=1
OCR_WORKERS=2
JEV_WORKERS=2
WORKER_COUNT_LOCAL=2
WORKER_COUNT_API=4
INGEST_BUFFER=16
OCR_BUFFER=8
JEV_BUFFER=8

# --- Timeouts ---
JOB_TIMEOUT=90s
SHUTDOWN_TIMEOUT=15s
OCR_TIMEOUT=30s
ASSIST_TIMEOUT=45s
JEV_TIMEOUT=30s

# --- Debug ---
DEBUG_PPROF=false
DEBUG_PPROF_ADDR=127.0.0.1:6060

# ============================================================
# DATABASE BACKEND
# ============================================================
# Options: "sqlite" (default) or "postgres"
DB_BACKEND=sqlite

# --- SQLite (default) ---
SQLITE_PATH=data/poc.db

# --- PostgreSQL (when DB_BACKEND=postgres) ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DBNAME=invoice_ocr
PG_SSLMODE=disable
PG_MAX_OPEN_CONNS=25
PG_MAX_IDLE_CONNS=10
PG_CONN_MAX_LIFETIME=1h
# Write optimization: "off" = fast writes (slight durability risk), "on" = safe
PG_SYNC_COMMIT=off

# ============================================================
# CACHE BACKEND
# ============================================================
# Options: "memory" (default) or "redis"
CACHE_BACKEND=memory
OCR_CACHE_ENABLED=true
OCR_CACHE_TTL=1h

# --- Redis (when CACHE_BACKEND=redis) ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# ============================================================
# OCR ENGINES
# ============================================================
OCR_MIN_CONFIDENCE=0.75
TESSERACT_LANG=por+eng

# --- OCR Engine Selection ---
# Options: "ollama", "openrouter", "tesseract"
OCR_ENGINE=ollama

# --- Ollama (local VLM) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_OCR_MODEL=glm-ocr:latest
OLLAMA_TIMEOUT=120s

# --- OpenRouter (cloud VLM) ---
OPENROUTER_OCR_MODEL=google/gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_TIMEOUT=45s

# ============================================================
# JEV (TypeSafe) - Document Classification
# ============================================================
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_TIMEOUT=30s
